# Backend API Configuration
# Update this URL to point to your backend server

# For development with backend running on your computer:
# 1. Find your computer's IP address: ipconfig (look for IPv4 Address)
# 2. Replace 192.168.1.100 with your actual IP address
# 3. Make sure backend is running on port 3000

# For physical Android device on same network:
API_URL=http://192.168.1.100:3000/api/v1

# For Android emulator (uncomment to use):
# API_URL=http://10.0.2.2:3000/api/v1

# For production backend (uncomment and update URL):
# API_URL=https://your-production-backend.com/api/v1

